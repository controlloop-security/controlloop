  "MAX_AUTHORITY_DELTA_ENTRIES": 200,
  "MAX_COMPONENT_ATTRIBUTES": 32,
  "PROHIBITED_ATTRIBUTE_KEY_FRAGMENTS": [
    "secret",
    "token",
    "password",
    "passwd",
    "credential",
    "api_key",
    "private_key",
    "env_value",
    "environment_value"
  ]
}
