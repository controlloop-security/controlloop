{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.controlloop.ai/acbom/1.2.0/acbom.schema.json",
  "title": "ControlLoop Agent Capability Bill of Materials",
  "description": "Canonical, deterministic, and sanitized ACBOM document for ControlLoop schema version 1.2.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator",
    "repository",
    "nodes",
    "edges",
    "diagnostics",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "nodes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "schema_url": {
      "oneOf": [
        {
          "$ref": "#/$defs/schemaUrl"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "safeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000-\\u001f\\u007f]+$"
    },
    "semanticVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "nodeType": {
      "type": "string",
      "enum": [
        "agent",
        "tool",
        "resource",
        "identity",
        "permission",
        "data-class",
        "trigger",
        "policy-boundary"
      ]
    },
    "nodeId": {
      "type": "string",
      "pattern": "^clp:(?:agent|tool|resource|identity|permission|data-class|trigger|policy-boundary):sha256:[0-9a-f]{64}$"
    },
    "edgeId": {
      "type": "string",
      "pattern": "^clp:edge:sha256:[0-9a-f]{64}$"
    },
    "edgeType": {
      "type": "string",
      "enum": [
        "invokes",
        "reads",
        "writes",
        "authenticates-as",
        "permitted-by",
        "delegates-to",
        "receives-from",
        "constrained-by"
      ]
    },
    "knownBoolean": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "root_digest"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
        },
        "root_digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "standardIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "identifier"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "identifier": {
          "$ref": "#/$defs/safeIdentifier"
        }
      }
    },
    "securityAttributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trusted": {
          "$ref": "#/$defs/optionalKnownBoolean"
        },
        "destructive": {
          "$ref": "#/$defs/optionalKnownBoolean"
        },
        "read_only": {
          "$ref": "#/$defs/optionalKnownBoolean"
        },
        "requires_approval": {
          "$ref": "#/$defs/optionalKnownBoolean"
        },
        "approval_present": {
          "$ref": "#/$defs/optionalKnownBoolean"
        },
        "privileged": {
          "$ref": "#/$defs/optionalKnownBoolean"
        },
        "financial_action": {
          "$ref": "#/$defs/optionalKnownBoolean"
        },
        "external_communication": {
          "$ref": "#/$defs/optionalKnownBoolean"
        },
        "code_execution": {
          "$ref": "#/$defs/optionalKnownBoolean"
        },
        "bypass_mode": {
          "$ref": "#/$defs/optionalKnownBoolean"
        },
        "wildcard": {
          "$ref": "#/$defs/optionalKnownBoolean"
        },
        "pinned": {
          "$ref": "#/$defs/optionalKnownBoolean"
        },
        "untrusted_input": {
          "$ref": "#/$defs/optionalKnownBoolean"
        },
        "sensitivity": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "unknown",
            null
          ]
        },
        "data_classifications": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeIdentifier"
          }
        },
        "permission_scopes": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeIdentifier"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter"
      ],
      "properties": {
        "adapter": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "path": {
          "oneOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "line_start": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ]
        },
        "line_end": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ]
        },
        "parser": {
          "oneOf": [
            {
              "$ref": "#/$defs/safeIdentifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/safeIdentifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "document_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256Digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "path"
              ]
            },
            {
              "required": [
                "document_digest"
              ]
            }
          ]
        },
        {
          "if": {
            "required": [
              "line_start"
            ]
          },
          "then": {
            "required": [
              "path"
            ]
          }
        },
        {
          "if": {
            "required": [
              "line_end"
            ]
          },
          "then": {
            "required": [
              "path",
              "line_start"
            ]
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "security_attributes",
        "confidence",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "$ref": "#/$defs/nodeType"
        },
        "subtype": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9._-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "security_attributes": {
          "$ref": "#/$defs/securityAttributes"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "standards_identifiers": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/standardIdentifier"
          }
        },
        "attributes": {
          "$ref": "#/$defs/nodeAttributes"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "subtype"
            ],
            "properties": {
              "subtype": {
                "const": "host"
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "const": "agent"
              },
              "attributes": {
                "required": [
                  "host"
                ]
              }
            },
            "required": [
              "attributes"
            ]
          }
        },
        {
          "if": {
            "required": [
              "subtype"
            ],
            "properties": {
              "subtype": {
                "const": "subagent"
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "const": "agent"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "subtype"
            ],
            "properties": {
              "subtype": {
                "const": "hook"
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "const": "tool"
              },
              "attributes": {
                "required": [
                  "event",
                  "hook_type"
                ]
              },
              "security_attributes": {
                "required": [
                  "code_execution"
                ],
                "properties": {
                  "code_execution": {
                    "$ref": "#/$defs/knownBoolean"
                  }
                }
              }
            },
            "required": [
              "attributes"
            ]
          }
        },
        {
          "if": {
            "required": [
              "subtype"
            ],
            "properties": {
              "subtype": {
                "const": "helper-command"
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "const": "tool"
              },
              "attributes": {
                "required": [
                  "setting"
                ]
              },
              "security_attributes": {
                "required": [
                  "code_execution"
                ],
                "properties": {
                  "code_execution": {
                    "$ref": "#/$defs/knownBoolean"
                  }
                }
              }
            },
            "required": [
              "attributes"
            ]
          }
        },
        {
          "if": {
            "required": [
              "subtype"
            ],
            "properties": {
              "subtype": {
                "const": "plugin"
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "const": "tool"
              },
              "attributes": {
                "required": [
                  "source_type"
                ]
              },
              "security_attributes": {
                "required": [
                  "pinned"
                ],
                "properties": {
                  "pinned": {
                    "$ref": "#/$defs/knownBoolean"
                  }
                }
              }
            },
            "required": [
              "attributes"
            ]
          }
        },
        {
          "if": {
            "required": [
              "subtype"
            ],
            "properties": {
              "subtype": {
                "const": "marketplace"
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "const": "tool"
              },
              "attributes": {
                "required": [
                  "source_type"
                ]
              },
              "security_attributes": {
                "required": [
                  "pinned"
                ],
                "properties": {
                  "pinned": {
                    "$ref": "#/$defs/knownBoolean"
                  }
                }
              }
            },
            "required": [
              "attributes"
            ]
          }
        },
        {
          "if": {
            "required": [
              "subtype"
            ],
            "properties": {
              "subtype": {
                "const": "skill"
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "const": "tool"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "subtype"
            ],
            "properties": {
              "subtype": {
                "const": "workflow-runtime"
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "const": "trigger"
              },
              "attributes": {
                "required": [
                  "job_permissions"
                ]
              }
            },
            "required": [
              "attributes"
            ]
          }
        },
        {
          "if": {
            "required": [
              "subtype"
            ],
            "properties": {
              "subtype": {
                "const": "permission-rule"
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "const": "permission"
              },
              "attributes": {
                "required": [
                  "effect",
                  "pattern"
                ]
              },
              "security_attributes": {
                "required": [
                  "wildcard"
                ],
                "properties": {
                  "wildcard": {
                    "$ref": "#/$defs/knownBoolean"
                  }
                }
              }
            },
            "required": [
              "attributes"
            ]
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "type",
        "status",
        "security_attributes",
        "confidence",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/edgeId"
        },
        "source": {
          "$ref": "#/$defs/nodeId"
        },
        "target": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "$ref": "#/$defs/edgeType"
        },
        "status": {
          "type": "string",
          "enum": [
            "direct",
            "inferred",
            "unknown"
          ]
        },
        "security_attributes": {
          "$ref": "#/$defs/securityAttributes"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "confidence",
        "incomplete",
        "evidence"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "$ref": "#/$defs/safeText"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "incomplete": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "schemaUrl": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://[^\\u0000-\\u001f\\u007f\\s]+$"
    },
    "optionalKnownBoolean": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "const": "unknown"
        },
        {
          "type": "null"
        }
      ]
    },
    "attributeValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "nodeAttributes": {
      "description": "Bounded, value-free attributes of an agent authority component (schema 1.2.0). Keys name what a file grants, never a value it protects.",
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_]*$",
        "not": {
          "pattern": "(value|password|passwd|private_key|prompt|body|output|source_code|source_content)"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/attributeValue"
      }
    }
  }
}
